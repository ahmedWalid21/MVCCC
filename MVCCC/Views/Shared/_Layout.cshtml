<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
</head>
<body>
    @*Start Header*@
    <center>
        <div class="m-5">
            <a href="/Home/Index" class="btn btn-primary">Home</a>
            <a href="/Home/AboutUs" class="btn btn-success">About Us</a>
            <a href="/Home/ContactUs" class="btn btn-danger">Contact Us</a>
            <a href="/Home/Privacy" class="btn btn-warning">Privacy</a>
        </div>
    </center>
    @*End Header*@

    <div>
        @RenderBody()
    </div>

    @*Start Footer*@
    <center>
        <div class="m-5">
            <p>
                copyrights &copy; Route @DateTime.Now.Year
            </p>
        </div>
    </center>
    @*End Footer*@

    @* HTML Helper*@
    @*
         <Center>
		<nav class="mt-5">
			<a href="/Home/Index" class="btn btn-primary">Home</a>
			<a href="/Home/AboutUs" class="btn btn-success">About Us</a>
			<a href="/Home/ContactUs" class="btn btn-danger">Contact Us</a>
			<a href="/Home/Privacy" class="btn btn-warning">Privacy</a>
			<nav>
    </Center>
    *@
    @*HTML Helper*@
    <center>
        <nav class="mt-5">
            @Html.ActionLink("Home", "Index", "Home", null, new { @class = "btn btn-primary" })
            @Html.ActionLink("About Us", "AboutUs", "Home", null, new { @class = "btn btn-danger" })
            @Html.ActionLink("Contact Us", "ContactUs", "Home", null, new { @class = "btn btn-success" })
            @Html.ActionLink("Privacy", "Privacy", "Home", null, new { @class = "btn btn-warning" })
        </nav>
    </center>

    @*Tag Helper*@
    <center>
        <nav class="mt-5">
            <a asp-controller="Home" asp-action="Index" class="btn btn-danger">Home</a>
            <a asp-controller="Home" asp-action="AboutUs" class="btn btn-primary">About Us</a>
            <a asp-controller="Home" asp-action="ContactUs" class="btn btn-success">Contact Us</a>
            <a asp-controller="Home" asp-action="Privacy" class="btn btn-warning">Privacy</a>
        </nav>
    </center>

  
</body>
</html>
